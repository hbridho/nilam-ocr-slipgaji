# Opsional, jarang perlu: semua setelan alur sudah ada di ../vm.env.example (termasuk LLM, Bedrock dan prompt).
# Berkas <service>.env di folder ini (orchestrator.env, extraction.env, structuring.env, ...) untuk setelan service yang
# TIDAK ada di sana, mis. penyetelan pipeline. Salin: cp structuring.env.example structuring.env.
# Setelan yang sudah ditulis di docker-compose.yml tidak bisa ditimpa dari sini (environment compose didahulukan).

# Contoh penyetelan job pipeline (bawaan di kode):
# PIPELINE_JOB_LEASE_SECONDS=300
# PIPELINE_RETRY_ATTEMPTS=3
# PIPELINE_OUTBOX_MAX_AGE_SECONDS=86400
# SCORING_TIMEOUT_SECONDS=10
