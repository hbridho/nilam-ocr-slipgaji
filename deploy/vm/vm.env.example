# ══════════════════════════════════════════════════════════════════════════════════════════════════════════
#  nilam-ocr-slipgaji: SATU .env UNTUK SELURUH ALUR (handover)
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════
#
#  Alur: Orkestrasi pusat -> orchestrator :8034 -> extraction :8030 (OCR) -> guardrail-blank :8035,
#        guardrail-blur :8036, guardrail-identity :8037 (bersamaan) -> structuring :8032 (aturan + LLM)
#        -> scoring :8033 -> Cloud SQL `nilam` + hasil ke Orkestrasi (callback / GET).
#
#  Pakai: salin ke `.env` di folder ini (deploy/vm), isi yang bertanda [WAJIB] / [RAHASIA], lalu
#        docker compose --profile migrate run --rm migrate && docker compose up -d     (lihat README.md)
#  docker-compose.yml membagikan tiap variabel hanya ke container yang memakainya. Variabel yang kosong
#  = bawaan service (ditulis di komentar). `.env` berisi rahasia: JANGAN commit (sudah di .gitignore),
#  bagikan lewat kanal aman, `chmod 600 .env`.
#
#  Setelan yang sama untuk GKE: deploy/helm/nilam-ocr-slipgaji/values*.yaml (bukan rahasia) +
#  Secret nilam-ocr-slipgaji-secrets (deploy/gke/secret.example.yaml). Untuk laptop: services/*/.env.example.

# ── 1. Image & VM ─────────────────────────────────────────────────────────────────────────────────────────
# Artifact Registry yang sama dengan GKE; TAG = SHA commit yang di-deploy (tidak pernah `latest`). [WAJIB]
REGISTRY=asia-southeast2-docker.pkg.dev/common-cicd-dev-01/gc-bribrain-dev-gar-temp-01
TAG=
# Alamat di VM tempat port 8034 (orchestrator) dibuka; batasi aksesnya dengan firewall VPC.
ORCHESTRATOR_BIND=0.0.0.0
# dev | staging | production. `local` hanya untuk laptop (membolehkan backend mock dan localhost).
ENVIRONMENT=dev

# ── 2. Keamanan API (semua service) ───────────────────────────────────────────────────────────────────────
# Header X-API-Key untuk setiap endpoint, juga dipakai antar-service. Diberikan ke Orkestrasi pusat. [WAJIB][RAHASIA]
API_KEY=
# Rotasi: key lain yang juga diterima, dipisah koma. [RAHASIA]
API_KEYS=

# ── 3. Pintu masuk: orchestrator (POST /v1/extract-ocr, GET /v1/extract-ocr/{request_id}) ───────────────
# Tunggu pipeline selesai sebelum menjawab 202 (detik). API spec [07]: 15. 0 = selalu 202.
PIPELINE_WAIT_SECONDS=15
# Batas berkas: halaman PDF (lebih -> 400 TOO_MANY_PAGES) dan ukuran (lebih -> 413). Bawaan 12 / 2,5 MB.
MAX_DOCUMENT_PAGES=12
MAX_UPLOAD_BYTES=2621440
# Host presigned MinIO yang boleh dipakai `file_url`, dipisah koma (".example.internal" = semua subdomain).
FILE_URL_ALLOWED_HOSTS=
# Endpoint -test untuk load test tim ML (tabel nilam_testing_*, tanpa callback). Dev saja.
TESTING_ENDPOINTS=false

# ── 4. OCR: extraction ───────────────────────────────────────────────────────────────────────────────────
# Layanan PaddleOCR (PP-OCRv6) yang dipanggil per halaman; harus terjangkau dari VM. [WAJIB]
# Dev GKE memakai http://10.213.128.67:8070.
EXTRACTION_OCR_URL=http://10.213.128.67:8070
# Bawaan: /ocr, field `file`, 60 dtk per halaman (compose), maks. 20 halaman, DPI render dari config.yaml.
EXTRACTION_OCR_ENDPOINT=
EXTRACTION_OCR_TIMEOUT_SECONDS=60
EXTRACTION_MAX_PAGES=
EXTRACTION_RENDER_DPI=

# ── 5. Guardrails (dipanggil extraction SETELAH OCR, bersamaan; urutan putusan kosong > buram > identitas) ─
# Mematikan satu guardrail: false. Dua yang lain tetap memutuskan; yang mati tercatat di `skipped`.
GUARDRAIL_BLANK_ENABLED=true
GUARDRAIL_BLUR_ENABLED=true
GUARDRAIL_IDENTITY_ENABLED=true
# Guardrail yang menyala tetapi tidak menjawab dilewati (true) atau menggagalkan job (false). Batas waktu per panggilan.
GUARDRAILS_FAIL_OPEN=true
GUARDRAILS_TIMEOUT_SECONDS=10
# Ambang bawaan tiap guardrail (per permintaan bisa ditimpa `guardrails_confidence_threshold`, sisi accept):
#   blank:    teks <= BLANK_MAX_CHARS karakter = halaman kosong (bawaan model: 20)
#   blur:     ambang P(halaman rusak) (bawaan model: 0,9584)
#   identity: lolos kalau P(slip gaji) >= IDENTITY_THRESHOLD (bawaan model: 0,47)
BLANK_MAX_CHARS=
BLUR_THRESHOLD=
IDENTITY_THRESHOLD=
# Ambang identity milik Orkestrasi pusat: GET URL+PATH menjawab {"threshold": x}, di-cache 60 dtk. Kosong = di atas.
IDENTITY_THRESHOLD_URL=
IDENTITY_THRESHOLD_PATH=/v1/thresholds/guardrails
IDENTITY_THRESHOLD_API_KEY=

# ── 6. Model dari GCS (guardrail-blank, -blur, -identity, scoring) ───────────────────────────────────────
# Diunduh saat start ke /tmp/models dan dicek; gagal = container tidak start. Kosong = model di dalam image.
# Bucket gc-bribrain-dev-gcs-ocr-nilam-01, folder nilam-ocr-slipgaji/ (diunggah dari dist/gcs/, ada manifest.json).
QUALITY_MODEL_GCS_URI=gs://gc-bribrain-dev-gcs-ocr-nilam-01/nilam-ocr-slipgaji/guardrails/unreadable_doc_confidence/v1/unreadable_doc_confidence_v1.json
IDENTITY_MODEL_GCS_URI=gs://gc-bribrain-dev-gcs-ocr-nilam-01/nilam-ocr-slipgaji/guardrails/is_slip_gaji_doc_confidence/v1/is_slip_gaji_doc_confidence_v1.json
SCORING_MODEL_GCS_URI=gs://gc-bribrain-dev-gcs-ocr-nilam-01/nilam-ocr-slipgaji/scoring/field_confidence/v1/field_confidence_v1.json
# SHA-256 dari manifest.json v1: model yang terunduh harus persis ini. Ganti bersama URI saat pindah versi.
QUALITY_MODEL_SHA256=d16af59c95c58669fb73f104cc026f0b33b8f4b5f037a55e91c2b19ee5464f55
IDENTITY_MODEL_SHA256=d0a5bc1469ab4ab8ff38a5dbb2d2e0e4f3446dd4639101d2ad0f6496945fe066
SCORING_MODEL_SHA256=d73569da7bc8b2d9af136a0d40cefcef6e9780813cb2b0ef1da3fa30925a69a6
# Identitas GCS: aplikasi Entra -> WIF -> gc-bribrain-dev-sac-gcs-01 (wif.gcs.env, Tim SEA). Isi SEMUA tujuh atau
# kosongkan SEMUA: setengah terisi (mis. tanpa GCS_AZURE_CLIENT_SECRET) membuat keempat service menolak start.
# Semua kosong = service account VM (butuh roles/storage.objectViewer di bucket). Nilai dev yang bukan rahasia:
#   GCS_AZURE_TENANT_ID=76795979-244b-45d7-b043-ae27e60f46ee   GCS_AZURE_CLIENT_ID=85add4a1-bd8e-48b1-9d72-658159f734a5
#   GCS_GCP_PROJECT_NUMBER=849229018263   GCS_GCP_POOL_ID=gc-entra-dev-idp-oidc-01   GCS_GCP_PROVIDER_ID=entra-bri-pool-dev
#   GCS_GCP_SERVICE_ACCOUNT_EMAIL=gc-bribrain-dev-sac-gcs-01@common-sec-dev-01.iam.gserviceaccount.com
GCS_AZURE_TENANT_ID=
GCS_AZURE_CLIENT_ID=
# [RAHASIA]
GCS_AZURE_CLIENT_SECRET=
GCS_GCP_PROJECT_NUMBER=
GCS_GCP_POOL_ID=
GCS_GCP_PROVIDER_ID=
GCS_GCP_SERVICE_ACCOUNT_EMAIL=

# ── 7. Structuring: teks -> 20 field per slip (aturan + arbitrase LLM) ───────────────────────────────────
# Arbitrase nilai uang lewat LLM: aturan saja 81,5% field benar, dengan LLM 89,9% (50 dokumen berlabel).
ENABLE_LLM=false
# Penyedia: bedrock (Entra ID -> STS -> Bedrock) | http (chat-completions ala OpenAI, mis. gateway di VPC) | off.
# Kosong = config.yaml di image (bedrock, model openai.gpt-oss-120b-1:0).
LLM_BACKEND=
LLM_MODEL=
LLM_ENDPOINT=
LLM_TIMEOUT_SECONDS=
LLM_MAX_TOKENS=
LLM_ALL_FIELDS=
LLM_REGION=
# LLM_BACKEND=http: nama VARIABEL berisi API key gateway (bukan key-nya), dan key-nya. [RAHASIA]
LLM_API_KEY_ENV=
LLM_GATEWAY_KEY=
# LLM_BACKEND=bedrock: aplikasi Entra + role AWS untuk Bedrock (BUKAN identitas GCS/Cloud SQL). [RAHASIA]
BEDROCK_AZURE_TENANT_ID=
BEDROCK_AZURE_CLIENT_ID=
BEDROCK_AZURE_CLIENT_SECRET=
BEDROCK_AWS_ROLE_ARN_BRIDGE=
BEDROCK_AWS_ROLE_ARN_TARGET=
# Prompt: file (bawaan, prompts/slip_gaji.v1.md di image) | db (tabel nilam_ocr_slipgaji.system_prompt, baris is_active;
# PROMPT_VERSION = nomor versi tertentu). DB tidak terbaca saat start -> file (true) atau menolak start (false).
PROMPT_SOURCE=file
PROMPT_VERSION=
PROMPT_DB_FALLBACK_TO_FILE=true
# Cache prompt di Redis, seperti nilam-ocr-shm: baris aktif dibaca dari key sebelum tiap job, jadi prompt baru berlaku
# begitu key dihapus (redis-cli DEL ocr:prompt:slipgaji) atau kedaluwarsa, TANPA restart. Key kosong -> tabel dibaca
# lalu key diisi. Butuh PROMPT_SOURCE=db dan PROMPT_VERSION kosong. Redis mati = prompt yang sedang dipakai tetap jalan.
STRUCTURING_PROMPT_REDIS_ENABLED=false
# Redis milik stack ini: COMPOSE_PROFILES=redis menyalakan container `redis` (8 container), REDIS_PASSWORD wajib diisi
# (huruf/angka saja, mis. `openssl rand -hex 24`). Pakai Redis Orkestrasi: kosongkan COMPOSE_PROFILES, isi URL-nya.
COMPOSE_PROFILES=
# [RAHASIA]
REDIS_PASSWORD=
# Kosong = redis://:<REDIS_PASSWORD>@redis:6379/0 (container di atas). [RAHASIA kalau berisi password]
STRUCTURING_REDIS_URL=
# Prefiks key tim: ocr:prompt:<dokumen> (ocr:prompt:ktp, ocr:prompt:shm, ocr:prompt:kk, ...).
STRUCTURING_PROMPT_REDIS_KEY=ocr:prompt:slipgaji
# Umur key yang ditulis service (detik); 0 = tidak kedaluwarsa.
STRUCTURING_PROMPT_REDIS_TTL_SECONDS=3600

# ── 8. Scoring: P(nilai benar) per field -> confidence 0/1 ───────────────────────────────────────────────
# Ambang bawaan bila permintaan tidak mengirim `column_confidence_threshold` (orchestrator dan scoring).
FIELD_CONFIDENCE_THRESHOLD=0.5

# ── 9. Database: Cloud SQL `nilam` (extraction, structuring, scoring, migrate) ───────────────────────────
# Seperti nilam-ocr-shm: Cloud SQL Python Connector sebagai service account lewat WIF Entra ID. Semua tabel di skema
# nilam_ocr_slipgaji (dibuat migrasi). VM harus menjangkau 10.213.224.113:3307; user butuh CREATE di `nilam` sekali.
CLOUDSQL_INSTANCE=edm-bribrain-dev-01:asia-southeast2:gc-bribrain-dev-sql-psql-01
CLOUDSQL_DATABASE=nilam
CLOUDSQL_IP_TYPE=PRIVATE
# User database. Keduanya kosong = login IAM sebagai service account di bawah (butuh flag cloudsql.iam_authentication).
CLOUDSQL_USER=bribrain_user
# [RAHASIA]
CLOUDSQL_PASSWORD=
# Aplikasi Entra untuk Cloud SQL -> WIF -> gc-bribrain-dev-sac-sql-01 (sama dengan cloudsql.env / connect_cloudsql.py).
CLOUDSQL_AZURE_TENANT_ID=76795979-244b-45d7-b043-ae27e60f46ee
CLOUDSQL_AZURE_CLIENT_ID=
# [RAHASIA]
CLOUDSQL_AZURE_CLIENT_SECRET=
CLOUDSQL_GCP_PROJECT_NUMBER=849229018263
CLOUDSQL_GCP_POOL_ID=gc-entra-dev-idp-oidc-01
CLOUDSQL_GCP_PROVIDER_ID=entra-bri-pool-dev
CLOUDSQL_GCP_SERVICE_ACCOUNT_EMAIL=gc-bribrain-dev-sac-sql-01@common-sec-dev-01.iam.gserviceaccount.com

# ── 10. Hasil ke Orkestrasi pusat (extraction, structuring, scoring) ─────────────────────────────────────
# Callback hasil: satu POST per request saat selesai/ditolak/gagal ke URL+PATH, header X-Callback-Key.
# URL harus terjangkau dari VM (bukan *.svc.cluster.local). Belum ada: ORCHESTRATION_CALLBACK_ENABLED=false
# (mode poll: Orkestrasi membaca GET /v1/extract-ocr/{request_id}).
ORCHESTRATION_URL=
ORCHESTRATION_CALLBACK_PATH=/v1/ocr-callback
ORCHESTRATION_CALLBACK_FORMAT=result
ORCHESTRATION_CALLBACK_ENABLED=false
# [RAHASIA] Wajib kalau callback menyala dengan format result.
ORCHESTRATION_CALLBACK_KEY=
# Format `stage` (callback per tahap) memakai key ini. [RAHASIA]
ORCHESTRATION_API_KEY=
ORCHESTRATION_TIMEOUT_SECONDS=10
# Berapa lama callback yang gagal dicoba ulang; samakan dengan OCR_CALLBACK_DEADLINE_SECONDS Orkestrasi.
ORCHESTRATION_CALLBACK_MAX_AGE_SECONDS=600
# Opsional: tulis status akhir ke tabel milik Orkestrasi (schema.table) di transaksi job.
ORCHESTRATION_OUTCOME_TABLE=
# Outbox transaksional: hand-off dan callback disimpan dulu, dikirim ulang dengan backoff (tidak hilang saat restart).
PIPELINE_OUTBOX=true

# ── 11. Log & Elastic APM (semua service) ────────────────────────────────────────────────────────────────
# Log ke stdout (docker logs). LOG_FORMAT kosong = json di luar ENVIRONMENT=local.
LOG_LEVEL=INFO
LOG_FORMAT=
# APM: kosong = mati (agen tidak dimuat). Nama service: ms-bribrain-nilam-ocr-slipgaji-<service>. Token ATAU API key.
ELASTIC_APM_SERVER_URL=
# [RAHASIA]
ELASTIC_APM_SECRET_TOKEN=
ELASTIC_APM_API_KEY=
ELASTIC_APM_ENVIRONMENT=dev
ELASTIC_APM_TRANSACTION_SAMPLE_RATE=1.0
ELASTIC_APM_VERIFY_SERVER_CERT=true
